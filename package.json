{
  "name": "moked-tasks",
  "private": true,
  "version": "1.0.0",
  "description": "יומן משימות מוקד - Moked task journal",
  "author": "dofer12",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run build && npm run electron:compile && electron .",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "demo": "vite --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "electron:demo": "tsc -b && vite build --mode demo --outDir dist-demo && npm run electron:compile && electron . --demo",
    "dist:win": "npm run build && npm run electron:compile && electron-builder --win nsis --publish never",
    "android:sync": "npm run build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "idb-keyval": "^6.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
